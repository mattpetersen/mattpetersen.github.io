<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#171919" media="(prefers-color-scheme: dark)">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
    <meta property="og:title" content="{{ title or site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
    <meta property="og:site_name" content="{{ site.name }}">
    {% if isPost %}<meta property="article:published_time" content="{{ page.date | dateToRfc3339 }}">{% endif %}
    {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/images/favicons/favicon-180.png">
    <link rel="stylesheet" href="/assets/main.css">
    {% if hasMath %}<link rel="stylesheet" href="/assets/katex/katex.min.css">{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <main id="main" tabindex="-1">{{ content | safe }}</main>
    </div>
  </body>
</html>
